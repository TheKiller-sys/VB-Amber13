# ============================================================
# VB AMBER13 — VARIABLES DE ENTORNO
# Copia este archivo a .env y rellena los valores reales.
# NUNCA comitees .env al repo.
# ============================================================

# ---------- SERVIDOR ----------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# API key para proteger los endpoints. Genera uno con:
#   openssl rand -hex 32
VB_AMBER_ADMIN_API_KEY=Josue2005

# CORS: origen del dashboard (ej. https://dashboard.midominio.com)
# Usa "*" solo en desarrollo local.
CORS_ORIGIN=*

# ---------- BASE DE DATOS ----------
DB_PATH=./data/vb-amber13.db
DB_WAL=true

# ---------- LOGGING ----------
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=json

# ---------- LLM ----------
# Proveedor: openai | anthropic | ollama
# Para Ollama local:
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=800
LLM_TEMPERATURE=0.85

# ---------- TWITTER / X ----------
# Necesitas app en https://developer.twitter.com/ con OAuth 2.0
TWITTER_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_USER_ID=

# ---------- INSTAGRAM (Meta Graph API) ----------
# Requiere: cuenta Business/Creator + app aprobada en Meta for Developers
INSTAGRAM_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
# Token de verificación de webhook (tú lo eliges y lo pones en Meta)
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ---------- LINKEDIN ----------
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------- COMPORTAMIENTO ----------
# draft | auto
# NUNCA empieces en 'auto'. Siempre 'draft' las primeras 2-4 semanas.
VB_AMBER_OPERATING_MODE=draft

# safetyLevel: strict | normal | permissive
VB_AMBER_SAFETY_LEVEL=strict

# Intervalo del loop (ms)
VB_AMBER_LOOP_INTERVAL_MS=90000

# Ventana de crisis (min): si hay > N negativos en esta ventana → pausa
VB_AMBER_CRISIS_NEGATIVE_THRESHOLD=5
VB_AMBER_CRISIS_WINDOW_MIN=60
