# vb-amber13 — copia a .env y rellena.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Admin API — mínimo 16 chars (32+ en producción)
VB_AMBER_ADMIN_API_KEY=Josue2005
CORS_ORIGIN=*

# DB
DB_PATH=./data/vb-amber13.db
DB_WAL=true

# Logs
LOG_LEVEL=info
LOG_FORMAT=pretty

# LLM (obligatorio en ambos transportes)
LLM_PROVIDER=ollama
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=800
LLM_TEMPERATURE=0.85

# ============================================================
# TRANSPORTE
# ============================================================
# 'api'      → usa APIs oficiales (requiere credenciales de cada plataforma)
# 'scraping' → usa Playwright + sesión guardada (login manual una vez)
VB_AMBER_TRANSPORT=scraping

# ============================================================
# API OFICIAL (solo si VB_AMBER_TRANSPORT=api)
# ============================================================

# Twitter / X
TWITTER_ENABLED=true
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_USER_ID=

# Instagram (Meta Graph API)
INSTAGRAM_ENABLED=true
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# LinkedIn
LINKEDIN_ENABLED=true
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ============================================================
# SCRAPING (solo si VB_AMBER_TRANSPORT=scraping)
# ============================================================

# Directorio de sesiones cifradas (una por plataforma)
VB_AMBER_SESSION_DIR=./data/sessions

# Clave maestra para cifrar storage_state. >= 32 caracteres.
# Genera con: openssl rand -base64 48
VB_AMBER_SESSION_ENCRYPTION_KEY=Josue2005

# Headless para operaciones (el login SIEMPRE es visible).
# En servidor sin display: true. En máquina local: false.
VB_AMBER_SCRAPING_HEADLESS=true

# Timeout del login manual (default 5 min)
VB_AMBER_SCRAPING_LOGIN_TIMEOUT_MS=300000

# Cada cuánto revalidar la sesión (default 15 min)
VB_AMBER_SCRAPING_HEALTH_CHECK_INTERVAL_MS=900000

# Delays humanos (jitter entre acciones)
VB_AMBER_SCRAPING_HUMAN_DELAY_MIN_MS=800
VB_AMBER_SCRAPING_HUMAN_DELAY_MAX_MS=2500

# Límites conservadores (más bajos que API para reducir detección)
VB_AMBER_SCRAPING_DAILY_POST_LIMIT=3
VB_AMBER_SCRAPING_HOURLY_REPLY_LIMIT=2

# ============================================================
# MODO OPERATIVO
# ============================================================
VB_AMBER_OPERATING_MODE=draft
VB_AMBER_SAFETY_LEVEL=strict
VB_AMBER_LOOP_INTERVAL_MS=90000
VB_AMBER_CRISIS_NEGATIVE_THRESHOLD=5
VB_AMBER_CRISIS_WINDOW_MIN=60
